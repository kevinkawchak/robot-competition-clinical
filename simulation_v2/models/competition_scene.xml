          <geom name="a_pat_visor" type="box" size="0.07 0.001 0.03" pos="0 -0.09 0.02" material="robot_visor"/>
        </body>
        <!-- Right arm (injection target — closest to nurse on right) -->
        <body name="a_pat_r_shoulder" pos="0.2 0 0.3">
          <joint name="a_pat_r_shoulder_pitch" type="hinge" axis="1 0 0" range="-90 90"/>
