      </body>
      <body name="a_pat_r_hip" pos="0.1 0 0">
        <joint name="a_pat_r_hip_flex" type="hinge" axis="1 0 0" range="-120 30"/>
        <geom name="a_pat_r_thigh" type="capsule" size="0.05" fromto="0 0 0 0 -0.25 0" material="patient_gown"/>
        <body name="a_pat_r_knee" pos="0 -0.25 0">
