<?xml version="1.0" encoding="utf-8"?>
<!--
  Clinical Robot Competition Scene — 4-Station 2x2 Grid
  G1 humanoid robots: Doctor (left, white coat) reviews symptoms,
  Nurse (right, blue coat) performs deltoid injection to patient's right arm.
  PPO-trained policies with different seeds per station.
  Attribution: Simulation framework inspired by mjlab (mujocolab/mjlab).
-->
<mujoco model="clinical_competition_sim">
  <compiler angle="degree" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002">
    <flag warmstart="enable"/>
  </option>
  <default>
    <joint armature="0.01" damping="0.5" limited="true"/>
    <geom condim="3" friction="1.0 0.5 0.5" margin="0.001"/>
  </default>

  <asset>
    <material name="floor_tile" rgba="0.92 0.92 0.95 1" specular="0.3"/>
    <material name="wall" rgba="0.95 0.96 0.98 1"/>
    <material name="doctor_shell" rgba="0.95 0.95 0.97 1" specular="0.4"/>
    <material name="nurse_shell" rgba="0.35 0.55 0.82 1" specular="0.3"/>
    <material name="patient_gown" rgba="0.55 0.78 0.55 1" specular="0.1"/>
    <material name="robot_joint" rgba="0.25 0.25 0.28 1" specular="0.6"/>
    <material name="robot_visor" rgba="0.1 0.3 0.6 0.8" specular="0.8"/>
    <material name="chair_frame" rgba="0.3 0.3 0.35 1" specular="0.5"/>
    <material name="chair_cushion" rgba="0.2 0.35 0.55 1" specular="0.1"/>
    <material name="syringe_body" rgba="0.85 0.87 0.9 1" specular="0.7"/>
    <material name="syringe_plunger" rgba="0.4 0.4 0.45 1"/>
    <material name="needle" rgba="0.75 0.77 0.8 1" specular="0.9"/>
    <material name="tray_metal" rgba="0.72 0.74 0.78 1" specular="0.8"/>
    <material name="iv_stand" rgba="0.65 0.65 0.7 1" specular="0.6"/>
    <material name="iv_bag" rgba="0.8 0.85 0.9 0.7"/>
    <material name="monitor_screen" rgba="0.05 0.15 0.05 1" specular="0.2"/>
    <material name="monitor_body" rgba="0.35 0.35 0.4 1"/>
  </asset>

  <worldbody>
    <!-- Ground and Lighting -->
    <geom name="floor" type="plane" size="8 8 0.05" material="floor_tile"/>
    <light name="overhead" pos="0 0 3.5" dir="0 0 -1" diffuse="0.9 0.9 0.95" specular="0.3 0.3 0.3" castshadow="true"/>
    <light name="fill" pos="4 -4 3" dir="-0.5 0.5 -0.7" diffuse="0.3 0.3 0.35"/>
    <geom name="wall_back" type="box" size="6 0.05 2" pos="0 -5 2" material="wall"/>
    <geom name="wall_left" type="box" size="0.05 5 2" pos="-6 0 2" material="wall"/>
    <geom name="wall_right" type="box" size="0.05 5 2" pos="6 0 2" material="wall"/>

    <!-- ============================== -->
    <!-- STATION A (front-left) at (-2.25, 0, -2.0) -->
    <!-- ============================== -->
    <body name="a_chair" pos="-2.25 0 -2.0">
      <geom name="a_seat" type="box" size="0.25 0.22 0.03" pos="0 0 0.47" material="chair_cushion"/>
      <geom name="a_back" type="box" size="0.25 0.03 0.3" pos="0 0.2 0.8" material="chair_cushion"/>
