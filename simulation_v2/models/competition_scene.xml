      <geom name="a_leg4" type="cylinder" size="0.025" fromto="0.2 0.15 0 0.2 0.15 0.45" material="chair_frame"/>
    </body>

    <!-- Station A Patient -->
    <body name="a_patient" pos="-2.25 0 -1.5">
      <geom name="a_pat_pelvis" type="box" size="0.16 0.1 0.06" material="patient_gown"/>
      <body name="a_pat_torso" pos="0 0 0.06">
