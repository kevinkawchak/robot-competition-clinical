      <geom name="a_arm_l" type="box" size="0.03 0.18 0.02" pos="-0.27 0 0.62" material="chair_frame"/>
      <geom name="a_leg1" type="cylinder" size="0.025" fromto="-0.2 -0.2 0 -0.2 -0.2 0.45" material="chair_frame"/>
      <geom name="a_leg2" type="cylinder" size="0.025" fromto="0.2 -0.2 0 0.2 -0.2 0.45" material="chair_frame"/>
